{
  "name": "vue-renderer-tunnel",
  "version": "0.1.0",
  "description": "Route Vue content between different Vue renderer roots.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "vue",
    "custom-renderer",
    "tresjs",
    "tunnel",
    "portal"
  ],
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "peerDependencies": {
    "vue": ">=3.4 <4"
  },
  "scripts": {
    "predev": "pnpm build",
    "dev": "pnpm --dir playground dev",
    "build": "tsdown",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p playground/tsconfig.json",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "consumer:check": "vue-tsc --noEmit -p tests/consumer/tsconfig.json && node tests/consumer/smoke.mjs",
    "pack:check": "pnpm build && publint && npm_config_cache=/tmp/vue-renderer-tunnel-npm-cache attw --pack --profile esm-only && pnpm consumer:check && npm_config_cache=/tmp/vue-renderer-tunnel-npm-cache npm pack --dry-run",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm build && pnpm pack:check && pnpm test:e2e"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.62.1",
    "@tresjs/core": "^5.8.3",
    "@types/node": "^24.0.0",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "jsdom": "^27.0.0",
    "publint": "^0.3.24",
    "three": "^0.185.1",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-tsc": "^3.2.0"
  },
  "packageManager": "pnpm@10.26.2"
}
